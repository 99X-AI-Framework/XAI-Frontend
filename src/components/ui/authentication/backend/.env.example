# Copy to backend/.env and fill in. Never commit the real file.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./auth.db
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]

# Required in production (dev falls back to insecure built-ins):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# OTP_PEPPER=

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

LOGIN_OTP_REQUIRED=true
OAUTH_REQUIRE_OTP=false

# Email: "console" prints OTPs to the server log (dev only)
EMAIL_BACKEND=console
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=
# SMTP_FROM=XAI Governance <no-reply@example.com>

# OAuth (provider is enabled only when both id + secret are present)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
